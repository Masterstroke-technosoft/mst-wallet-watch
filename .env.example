# ==============================================================================
# MST-WalletWatch Environment Configuration
# ==============================================================================

# Network RPC Endpoints
TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MAINNET_RPC_URL=https://mariorpc.mstblockchain.com
TESTNET_CHAIN_ID=91562037
MAINNET_CHAIN_ID=4646
TESTNET_EXPLORER_URL=https://testnet.mstscan.com
MAINNET_EXPLORER_URL=https://mstscan.com
TESTNET_CURRENCY_SYMBOL=tMSTC
MAINNET_CURRENCY_SYMBOL=MSTC

# Wallets to Monitor (Comma-separated Ethereum/EVM addresses)
WALLETS_TO_MONITOR=0x000000000000000000000000000000000000dEaD,0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# Native Currency Balance Thresholds (in native units, e.g. 0.1 tMSTC / 0.1 MSTC)
BALANCE_THRESHOLD_TESTNET=0.1
BALANCE_THRESHOLD_MAINNET=0.1

# Scheduler Configuration (e.g. "1 Hr", "30 Min", "10 Mint", "5 Min", or cron "0 * * * *")
CHECK_INTERVAL=1 Hr
RUN_ON_STARTUP=true

# Email Notification via Nodemailer (SMTP)
# For Gmail: Use smtp.gmail.com, port 587, and an App Password (not your regular login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="MST WalletWatch" <your_email@gmail.com>
EMAIL_TO=recipient@example.com
